{
  "name": "cine-western",
  "productName": "Ciné Western",
  "version": "1.0.0",
  "description": "Catalogue et gestionnaire de films western : catalogue, collection, journal, listes et sagas, quiz, statistiques.",
  "author": {
    "name": "Didier Beltran"
  },
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "homepage": "https://github.com/didail84/cine-western",
  "repository": {
    "type": "git",
    "url": "https://github.com/didail84/cine-western.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "43.7.11",
    "electron-builder": "26.17.0"
  },
  "desktop": {
    "host": "cine-western",
    "repo": "didail84/cine-western",
    "background": "#17130F",
    "api": "cwDesktop",
    "syncFile": "CineWestern-synchro.json"
  },
  "build": {
    "appId": "io.github.didail84.cinewestern",
    "productName": "Ciné Western",
    "artifactName": "CineWestern-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "identity": "-",
      "minimumSystemVersion": "12.0",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSCameraUsageDescription": "La caméra sert à scanner les codes-barres de tes DVD et Blu-ray."
      }
    },
    "dmg": {
      "title": "Ciné Western ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ciné Western",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "publish": null
  }
}